# ===========================================
# Пример конфигурации проекта (скопируйте и заполните своими значениями):
#   cp core/config.env.example core/config.env
# Файл core/config.env содержит секреты и НЕ должен попадать в git!
# ===========================================

# ===========================================
# Настройки базы данных
# ===========================================
DB_LOGIN="your_db_user"
DB_PASSWORD="your_db_password"
DB_HOST="127.0.0.1"
DB_NAME="vetMinsk_usyplenie"
DB_CHARSET="utf8mb4"
DB_DRIVER="mysql"

# ===========================================
# DateTime config
# ===========================================
DEFAULT_TIMEZONE=Europe/Minsk
DATE_TPL=Y-m-d
TIME_TPL=H:i:s

# ===========================================
# Режим работы
# ===========================================
ACTIVE_MODE=MODE_DB

# ===========================================
# Настройки сессий
# ===========================================
SAVE_SESSION_HANDLER=redis
SAVE_SESSION_PATH_METHOD=tcp
SAVE_SESSION_PATH_HOST=127.0.0.1
SAVE_SESSION_PATH_PORT=6379
SAVE_SESSION_PATH_AUTH=
SESSION.GC_MAXLIFETIME=3600
SESSION.COOKIE_LIFETIME=3600
SESSION.COOKIE_HTTPONLY=1
SESSION.COOKIE_SECURE=1
SESSION.COOKIE_SAMESITE=strict

# ===========================================
# Настройки сайта
# ===========================================
SITE_URL="https://usyplenie.103vet.by/"
SITE_NAME="Достойный уход"

# ===========================================
# Режим отладки (true — показывать стек-трейсы, false/пусто — продакшен)
# Значения из .env имеют приоритет над config.env
# ===========================================
APP_DEBUG=false
